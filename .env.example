# Copy to .env for local dev, or .env.prod on the server. Never commit the real file.

# Postgres connection string used by the app + Alembic.
# Local:  postgresql://<user>:<password>@localhost:5432/<db>
# Docker: postgresql://<user>:<password>@host.docker.internal:5432/<db>
# Neon (prod, pooled): postgresql://<user>:<password>@<endpoint>-pooler.<region>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/greenfield

# Used to sign JWTs. Generate a strong random value for prod, e.g.: openssl rand -hex 32
SECRET_KEY=change-me

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7

# "local" or "production" — reserved for environment-specific branching/logging.
ENVIRONMENT=local

# Comma-separated list of allowed frontend origins for CORS.
# Local example:  http://localhost:3000
# Prod example:   https://greenfield-academy.vercel.app,https://api.<server-ip>.sslip.io
CORS_ORIGINS=http://localhost:3000
