# Copy to .env for local dev, or .env.prod on the server. Never commit the real file.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/greenfield # or the live db conn on prod

SECRET_KEY=change-me

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=local # or production

CORS_ORIGINS=http://localhost:3000 # or https.... the frontend website on prod

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CAPTCHA_SECRET_KEY=

ADMISSION_MAX_FILE_SIZE_BYTES=10240
ADMISSION_MAX_PHOTO_SIZE_BYTES=20480
ADMISSION_MAX_FILES=4
ADMISSION_RATE_LIMIT_PER_HOUR=5
ADMISSION_RATE_LIMIT_PER_DAY=20
ADMISSION_VERIFY_MAX_ATTEMPTS=5
ADMISSION_VERIFY_LOCKOUT_MINUTES=30
